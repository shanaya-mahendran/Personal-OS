{
  "name": "shanaya-os",
  "version": "1.0.0",
  "private": true,
  "description": "Shanaya OS - an AI-assisted, context-aware Personal Operating System",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:local": "node scripts/start-local.mjs",
    "start:prod": "node scripts/start-prod.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
