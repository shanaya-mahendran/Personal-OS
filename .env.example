# ── Browser-safe (exposed to the client bundle) ───────────────────────────────
# Add: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://bqznwhtoiensvhbvoqcb.supabase.co

# Add: your anon/public JWT key from Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The canonical URL of your deployment (no trailing slash).
# On Vercel this is set automatically via VERCEL_URL; you can also set it
# explicitly so magic-link / OAuth redirects resolve correctly.
# Example: https://shanaya-os.vercel.app
NEXT_PUBLIC_APP_URL=

# ── Server-only. Never prefix with NEXT_PUBLIC_ ───────────────────────────────
# Add: your service-role key from Supabase Project Settings → API
SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini for Edge Functions (Edge Function secrets, never in bundle) ────────
# Add: your Google Gemini API key from Google AI Studio
GEMINI_API_KEY=
